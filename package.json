{
  "name": "amazon-au-ui-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rimraf test-results playwright-report allure-results allure-report",
    "pretest": "npm run clean",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium-ui",
    "test:api": "playwright test --project=api-pipeline",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "docker:dev": "docker compose run --rm tests-dev ; npx allure open allure-report-dev",
    "docker:qa": "docker compose run --rm tests-qa ; npx allure open allure-report-qa"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.21",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.12.2",
    "dotenv": "^16.4.5",
    "reporting-labs": "^0.6.13",
    "rimraf": "^6.1.3",
    "typescript": "^5.0.0"
  },
  "description": "This project contains three Playwright UI automation tests for Amazon Australia:",
  "main": "index.js",
  "keywords": [],
  "author": "Ragul Kulandaivelu",
  "license": "ISC",
  "type": "commonjs"
}